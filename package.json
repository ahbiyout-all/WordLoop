{
  "name": "react-example",
  "private": true,
  "version": "4.9.0",
  "description": "WordLoop English Vocabulary & Sentence Learning App with Interactive 5-Stage Study Pet Sanctuary (Sentiment Indicator, 7-Day Mood Trend Chart, Study Boost 2x Coins, Evolution Animation, Hunger Timer & Earn Food Quiz, Coins/Rooms/Costumes, Bilingual TTS, Streak Shield), Cognitive Game Engine (SM-2 SRS, JOL, ZPD), 3-Tier Local Storage, and 7-Layer Keyless Free AI",
  "author": "WordLoop Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/build-web.js && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:web": "node scripts/build-web.js",
    "pc:dev": "electron .",
    "pc:build": "node scripts/build-electron.js",
    "android:sync": "node scripts/sync-android.js auto",
    "apk:build": "node scripts/package-apk.cjs",
    "build:apk": "node scripts/package-apk.cjs",
    "build:pc": "node scripts/build-electron.js",
    "build:android": "node scripts/sync-android.js auto",
    "build:all": "node scripts/build-electron.js && node scripts/sync-android.js auto",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js android dist_electron",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.wordloop.app",
    "productName": "WordLoop",
    "publish": null,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "nsis",
      "artifactName": "WordLoop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
